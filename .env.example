# =========================================================================
# Doctar Backend — Environment Variable Configuration Template
# Copy this file to '.env' and fill in the values for local development.
# =========================================================================

# --- Port Configuration ---
PORT=3001
NODE_ENV=development

# --- MongoDB Database URI ---
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://aryautkarsh21_db_user:SJHXYbu8BaVuRdiZ@cluster0.4dkoyxn.mongodb.net/doctar?appName=Cluster0

# --- Admin Authentication ---
ADMIN_PASSWORD=doctar2024

# --- Email Notifications (Nodemailer / SMTP) ---
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
ADMIN_EMAIL=admin-receiver-email@gmail.com

# --- Cloudinary Uploads (Optional, for managing images) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Twilio SMS Notifications (Optional) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number
